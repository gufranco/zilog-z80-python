  "documentContradictions": [
    {
      "id": "ld-dd-nn-m-cycle-count",
      "manualPage": 99,
      "instruction": "LD dd, nn",
      "printed": "M Cycles 2, T States 10 (4, 3, 3)",
      "problem": "The breakdown has three groups and sums to ten. Two machine cycles cannot contain three groups of T states.",
      "reading": "Three machine cycles. The breakdown is the column closest to the silicon and it is internally consistent; the M Cycles column is not.",
      "verifiedOn": "the rendered page image, 2026-08-21, so this is what the document prints rather than an artefact of extracting its text"
    },
    {
      "id": "res-r-m-cycle-count",
      "manualPage": 260,
      "instruction": "RES r",
      "printed": "M Cycles 4, T States 8 (4, 4)",
      "problem": "Two groups summing to eight cannot be four machine cycles. The other three rows in the same table, RES (HL), RES (IX+d) and RES (IY+d), all have a group count matching their M Cycles column.",
      "reading": "Two machine cycles: the prefix fetch and the opcode fetch.",
      "verifiedOn": "the rendered page image, 2026-08-21"
    },
    {
      "id": "jr-nc-e-m-cycle-count",
      "manualPage": 269,
      "instruction": "JR NC, e",
      "printed": "If the condition is not met: M Cycles 7, T States 7 (4, 3)",
      "problem": "The M Cycles column repeats the T States value. Two groups summing to seven are two machine cycles.",
      "reading": "Two machine cycles. The condition-met row on the same page prints 3 and 12 (4, 3, 5), which is consistent.",
      "verifiedOn": "the rendered page image, 2026-08-21"
